{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/pr-self-review/scripts/guard-pr.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/agents/scripts/commit-gate.sh\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "sdd-engineering@dev-digest-ai-marketplace": true,
    "engineering-paved-path@dev-digest-ai-marketplace": true,
    "research-tools@dev-digest-ai-marketplace": true,
    "architecture-review@dev-digest-ai-marketplace": true
  },
  "extraKnownMarketplaces": {
    "dev-digest-ai-marketplace": {
      "source": {
        "source": "github",
        "repo": "vklyovsa/dev-digest-ai-marketplace"
      }
    }
  }
}
