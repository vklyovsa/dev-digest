+  async applyRefresh(prId: string, fresh: PrDetail): Promise<void> {
+    await this.pulls.updateHead(prId, {
+      title: fresh.title,
+      headSha: fresh.head_sha,
+      status: fresh.status,
+      updatedAt: fresh.updated_at ? new Date(fresh.updated_at) : null,
+    });
+    await this.pulls.updateDetail(
+      prId,
+      fresh.body ?? null,
+      {
+        additions: fresh.additions,
+        deletions: fresh.deletions,
+        filesCount: fresh.files_count,
+      },
+      fresh.labels ?? [],
+    );
+    await this.pulls.replaceFiles(prId, fresh.files);
+    await this.pulls.replaceCommits(prId, fresh.commits);
