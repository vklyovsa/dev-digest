+  app.post('/pulls/:id/refresh', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    const pull = await container.pullsRepo.getById(workspaceId, req.params.id);
+    if (!pull) throw new NotFoundError('Pull request not found');
+    if (pull.status === 'merged' || pull.status === 'closed') {
+      throw new AppError('pull_not_open', 'Only an open pull request can be refreshed.', 409);
+    }
+    const repo = await container.repoRepo.getById(workspaceId, pull.repoId);
+    if (!repo) throw new NotFoundError('Repo not found');
+
+    const github = await container.github();
+    const fresh = await github.getPullRequest({ owner: repo.owner, name: repo.name }, pull.number);
+    await service.applyRefresh(pull.id, fresh);
+    return { refreshed: pull.id, head_sha: fresh.head_sha };
+  });
 }
