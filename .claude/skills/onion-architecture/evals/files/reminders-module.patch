+export interface ReminderLine {
+  number: number;
+  title: string;
+  author: string;
+}
+
+export function formatReminder(repoFullName: string, pulls: readonly ReminderLine[]): string {
+  const lines = pulls.map((p) => `• #${p.number} ${p.title} — @${p.author}`);
+  return [`*${repoFullName}*: ${pulls.length} pull request(s) waiting for review`, ...lines].join('\n');
+}
--- a/server/src/modules/reminders/repository.ts
+++ b/server/src/modules/reminders/repository.ts
@@ -0,0 +1,26 @@
+import { and, asc, eq, isNull, ne, or } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import type { PullRow } from '../../db/rows.js';
+import * as t from '../../db/schema.js';
+
+export class RemindersRepository {
+  constructor(private db: Db) {}
+
+  async listAwaitingReview(repoId: string, limit: number): Promise<PullRow[]> {
+    return this.db
+      .select()
+      .from(t.pullRequests)
+      .where(
+        and(
+          eq(t.pullRequests.repoId, repoId),
+          eq(t.pullRequests.status, 'open'),
+          or(
+            isNull(t.pullRequests.lastReviewedSha),
+            ne(t.pullRequests.lastReviewedSha, t.pullRequests.headSha),
+          ),
+        ),
+      )
+      .orderBy(asc(t.pullRequests.openedAt))
+      .limit(limit);
+  }
+}
