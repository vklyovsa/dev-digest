@@ -0,0 +1,53 @@
+import type { SecretsProvider } from '@devdigest/shared';
+import type { Db } from '../../db/client.js';
+import type { PullRow } from '../../db/rows.js';
+import { AppError, ExternalServiceError, NotFoundError } from '../../platform/errors.js';
+import { RepoRepository } from '../repos/repository.js';
+import { REMINDER_MAX_PULLS, SLACK_TIMEOUT_MS, SLACK_WEBHOOK_SECRET } from './constants.js';
+import { formatReminder } from './helpers.js';
+import type { RemindersRepository } from './repository.js';
+
+export interface ReminderResult {
+  sent: number;
+}
+
+export class RemindersService {
+  private readonly repos: RepoRepository;
+
+  constructor(
+    private readonly reminders: RemindersRepository,
+    private readonly secrets: SecretsProvider,
+    db: Db,
+  ) {
+    this.repos = new RepoRepository(db);
+  }
+
+  async pending(workspaceId: string, repoId: string): Promise<PullRow[]> {
+    const repo = await this.repos.getById(workspaceId, repoId);
+    if (!repo) throw new NotFoundError('Repo not found');
+    return this.reminders.listAwaitingReview(repo.id, REMINDER_MAX_PULLS);
+  }
+
+  async send(workspaceId: string, repoId: string): Promise<ReminderResult> {
+    const repo = await this.repos.getById(workspaceId, repoId);
+    if (!repo) throw new NotFoundError('Repo not found');
+
+    const pulls = await this.reminders.listAwaitingReview(repo.id, REMINDER_MAX_PULLS);
+    if (pulls.length === 0) return { sent: 0 };
+
+    const url = await this.secrets.get(SLACK_WEBHOOK_SECRET);
+    if (!url) {
+      throw new AppError('slack_not_configured', 'Add a Slack webhook URL to send reminders.', 400);
+    }
+
+    const res = await fetch(url, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ text: formatReminder(repo.fullName, pulls) }),
+      signal: AbortSignal.timeout(SLACK_TIMEOUT_MS),
+    });
+    if (!res.ok) throw new ExternalServiceError(`Slack webhook responded with ${res.status}`);
+
+    return { sent: pulls.length };
+  }
+}
