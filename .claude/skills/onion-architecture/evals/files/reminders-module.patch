+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+
+export default async function remindersRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const { container } = app;
+  const service = container.remindersService;
+
+  app.get('/repos/:id/reminders', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    return service.pending(workspaceId, req.params.id);
+  });
+
+  app.post('/repos/:id/reminders', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    return service.send(workspaceId, req.params.id);
+  });
+}
