@@ -0,0 +1,32 @@
+import { DIGEST_TIMEZONE } from './constants.js';
+import type { StalePull } from './repository.js';
+
+const DAY_MS = 86_400_000;
+
+const dayFormat = new Intl.DateTimeFormat('en-GB', {
+  timeZone: DIGEST_TIMEZONE,
+  day: '2-digit',
+  month: 'short',
+});
+
+function ageInDays(at: Date | null): number {
+  if (!at) return 0;
+  return Math.floor((Date.now() - at.getTime()) / DAY_MS);
+}
+
+function openedOn(at: Date | null): string {
+  return at ? dayFormat.format(at) : 'unknown';
+}
+
+export function isStale(pull: StalePull, staleDays: number): boolean {
+  return ageInDays(pull.updatedAt) >= staleDays;
+}
+
+export function formatDigest(repoFullName: string, pulls: readonly StalePull[]): string {
+  const lines = pulls.map(
+    (p) =>
+      `• #${p.number} ${p.title} — @${p.author}, opened ${openedOn(p.openedAt)}, ` +
+      `${ageInDays(p.updatedAt)}d without updates`,
+  );
+  return [`*${repoFullName}*: ${pulls.length} stale pull request(s)`, ...lines].join('\n');
+}
