+import { and, asc, eq } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import * as t from '../../db/schema.js';
+
+export class DigestRepository {
+  constructor(private db: Db) {}
+
+  async listOpen(repoId: string, limit: number) {
+    return this.db
+      .select()
+      .from(t.pullRequests)
+      .where(and(eq(t.pullRequests.repoId, repoId), eq(t.pullRequests.status, 'open')))
+      .orderBy(asc(t.pullRequests.updatedAt))
+      .limit(limit);
+  }
+}
+
+export type StalePull = Awaited<ReturnType<DigestRepository['listOpen']>>[number];
