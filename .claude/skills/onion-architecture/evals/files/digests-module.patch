+import type { FastifyRequest } from 'fastify';
+import type { Container } from '../../platform/container.js';
+import { AppError, NotFoundError } from '../../platform/errors.js';
+import { getContext } from '../_shared/context.js';
+import type { DigestPreview, DigestRepo, DigestSendResult } from './types.js';
+
+async function requireRepo(
+  container: Container,
+  req: FastifyRequest,
+  repoId: string,
+): Promise<DigestRepo> {
+  const { workspaceId } = await getContext(container, req);
+  const repo = await container.repoRepo.getById(workspaceId, repoId);
+  if (!repo) throw new NotFoundError('Repo not found');
+  if (!repo.clonePath) {
+    throw new AppError('repo_not_ready', 'The repository is still being cloned.', 409);
+  }
+  return { id: repo.id, fullName: repo.fullName };
+}
+
+export async function previewDigest(
+  container: Container,
+  req: FastifyRequest,
+  repoId: string,
+): Promise<DigestPreview> {
+  const repo = await requireRepo(container, req, repoId);
+  return container.digestService.preview(repo);
+}
+
+export async function sendDigest(
+  container: Container,
+  req: FastifyRequest,
+  repoId: string,
+): Promise<DigestSendResult> {
+  const repo = await requireRepo(container, req, repoId);
+  return container.digestService.send(repo);
+}
