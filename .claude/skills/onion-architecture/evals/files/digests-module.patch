+  );
+
+  app.post('/repos/:id/digest', { schema: { params: IdParams } }, (req) =>
+    sendDigest(container, req, req.params.id),
+  );
+}
--- a/server/src/modules/digests/service.ts
+++ b/server/src/modules/digests/service.ts
@@ -0,0 +1,31 @@
+import type { SecretsProvider } from '@devdigest/shared';
+import { DIGEST_MAX_PULLS, DIGEST_STALE_DAYS } from './constants.js';
+import { formatDigest, isStale } from './helpers.js';
+import { resolveNotifier } from './notifier.js';
+import type { DigestRepository } from './repository.js';
+import type { DigestPreview, DigestRepo, DigestSendResult } from './types.js';
+
+export class DigestService {
+  constructor(
+    private readonly digests: DigestRepository,
+    private readonly secrets: SecretsProvider,
+  ) {}
+
+  async preview(repo: DigestRepo): Promise<DigestPreview> {
+    const open = await this.digests.listOpen(repo.id, DIGEST_MAX_PULLS);
+    return {
+      repo: repo.fullName,
+      stale_days: DIGEST_STALE_DAYS,
+      pulls: open.filter((pull) => isStale(pull, DIGEST_STALE_DAYS)),
+    };
+  }
+
+  async send(repo: DigestRepo): Promise<DigestSendResult> {
+    const { pulls } = await this.preview(repo);
+    if (pulls.length === 0) return { sent: 0 };
+
+    const notifier = await resolveNotifier(this.secrets);
+    await notifier.send(formatDigest(repo.fullName, pulls));
+    return { sent: pulls.length };
+  }
+}
