+import type { DigestNotifier, SecretsProvider } from '@devdigest/shared';
+import { SlackDigestNotifier } from '../../adapters/notifier/slack.js';
+import { AppError } from '../../platform/errors.js';
+import { DIGEST_WEBHOOK_SECRET } from './constants.js';
+
+export async function resolveNotifier(secrets: SecretsProvider): Promise<DigestNotifier> {
+  const url = await secrets.get(DIGEST_WEBHOOK_SECRET);
+  if (!url) {
+    throw new AppError('digest_not_configured', 'Add a Slack webhook URL to send digests.', 400);
+  }
+  return new SlackDigestNotifier(url);
+}
