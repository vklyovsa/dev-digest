+import { canonicalLabel } from '@devdigest/reviewer-core';
+import { MAX_LABEL_LENGTH, MAX_LABELS_PER_PULL, PATH_LABELS } from './constants.js';
+
+/** Trim, canonicalise, de-duplicate and cap a raw label list. Order is kept. */
+export function normalizeLabels(raw: readonly string[]): string[] {
+  const seen = new Set<string>();
+  for (const value of raw) {
+    const label = canonicalLabel(value.trim());
+    if (!label || label.length > MAX_LABEL_LENGTH) continue;
+    seen.add(label);
+    if (seen.size === MAX_LABELS_PER_PULL) break;
+  }
+  return [...seen];
+}
+
+/** Labels implied by the paths a pull request changes. */
+export function labelsForPaths(paths: readonly string[]): string[] {
+  const found = new Set<string>();
+  for (const path of paths) {
+    for (const [prefix, label] of Object.entries(PATH_LABELS)) {
+      if (path.startsWith(prefix)) found.add(label);
+    }
+  }
+  return [...found];
+}
