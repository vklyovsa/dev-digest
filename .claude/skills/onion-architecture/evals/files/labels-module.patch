+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { z } from 'zod';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+
+const LabelList = z.object({ labels: z.array(z.string()) });
+
+export default async function labelsRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const service = app.container.labelsService;
+
+  app.get(
+    '/pulls/:id/labels',
+    { schema: { params: IdParams, response: { 200: LabelList } } },
+    async (req) => {
+      const { workspaceId } = await getContext(app.container, req);
+      return { labels: await service.listForPull(workspaceId, req.params.id) };
+    },
+  );
+
+  app.get(
+    '/pulls/:id/labels/suggestions',
+    { schema: { params: IdParams, response: { 200: LabelList } } },
+    async (req) => {
+      const { workspaceId } = await getContext(app.container, req);
+      return { labels: await service.suggestForPull(workspaceId, req.params.id) };
+    },
+  );
+
+  app.post('/pulls/:id/labels/sync', { schema: { params: IdParams } }, async (req, reply) => {
+    const { workspaceId } = await getContext(app.container, req);
+    const pull = await service.getPull(workspaceId, req.params.id);
+
+    if (pull.status === 'merged' || pull.status === 'closed') {
+      reply.status(409);
+      return { error: 'Labels of a closed pull request are frozen' };
+    }
+
+    const repo = await app.container.repoRepo.getById(workspaceId, pull.repoId);
+    if (!repo) {
+      reply.status(404);
+      return { error: 'Repo not found' };
+    }
+
+    const github = await app.container.github();
+    const remote = await github.getPullRequest({ owner: repo.owner, name: repo.name }, pull.number);
+    return { labels: await service.replaceLabels(workspaceId, pull.id, remote.labels ?? []) };
+  });
+}
