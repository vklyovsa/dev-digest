+/** Labels longer than this are dropped rather than truncated. */
+export const MAX_LABEL_LENGTH = 50;
+
+/** A pull request carries at most this many labels after a sync. */
+export const MAX_LABELS_PER_PULL = 20;
+
+/** Path prefix → the label suggested for a pull request that touches it. */
+export const PATH_LABELS: Readonly<Record<string, string>> = {
+  'docs/': 'documentation',
+  'test/': 'tests',
+  'src/db/migrations/': 'migration',
+  '.github/': 'ci',
+};
