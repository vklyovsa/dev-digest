+import type { PullRow } from '../../db/rows.js';
+import type { Container } from '../../platform/container.js';
+import { NotFoundError } from '../../platform/errors.js';
+import { PullsRepository } from '../pulls/repository.js';
+import { labelsForPaths, normalizeLabels } from './helpers.js';
+import { LabelsRepository } from './repository.js';
+
+export class LabelsService {
+  private readonly labels: LabelsRepository;
+  private readonly pulls: PullsRepository;
+
+  constructor(private readonly container: Container) {
+    this.labels = new LabelsRepository(container.db);
+    this.pulls = new PullsRepository(container.db);
+  }
+
+  async getPull(workspaceId: string, prId: string): Promise<PullRow> {
+    const pull = await this.labels.findPull(workspaceId, prId);
+    if (!pull) throw new NotFoundError('Pull request not found');
+    return pull;
+  }
+
+  async listForPull(workspaceId: string, prId: string): Promise<string[]> {
+    const pull = await this.getPull(workspaceId, prId);
+    return normalizeLabels(pull.labels);
+  }
+
+  async suggestForPull(workspaceId: string, prId: string): Promise<string[]> {
+    const pull = await this.getPull(workspaceId, prId);
+    const files = await this.pulls.listFiles(pull.id);
+    const current = new Set(normalizeLabels(pull.labels));
+    return labelsForPaths(files.map((f) => f.path)).filter((label) => !current.has(label));
+  }
+
+  async replaceLabels(workspaceId: string, prId: string, labels: readonly string[]): Promise<string[]> {
+    const next = normalizeLabels(labels);
+    await this.labels.setLabels(workspaceId, prId, next);
+    return next;
+  }
+}
