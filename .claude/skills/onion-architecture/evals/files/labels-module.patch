+import { describe, expect, it } from 'vitest';
+import { labelsForPaths, normalizeLabels } from '../src/modules/labels/helpers.js';
+
+describe('normalizeLabels', () => {
+  it('trims, lower-cases and de-duplicates while keeping order', () => {
+    expect(normalizeLabels([' Bug ', 'bug', 'API'])).toEqual(['bug', 'api']);
+  });
+
+  it('drops empty and over-long labels', () => {
+    expect(normalizeLabels(['', 'x'.repeat(51), 'ok'])).toEqual(['ok']);
+  });
+});
+
+describe('labelsForPaths', () => {
+  it('maps path prefixes onto labels once each', () => {
+    expect(labelsForPaths(['docs/a.md', 'docs/b.md', 'test/a.test.ts'])).toEqual([
+      'documentation',
+      'tests',
+    ]);
+  });
+});
