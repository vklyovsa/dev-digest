+import { readFileSync } from 'node:fs';
+
+type AliasMap = Record<string, string>;
+
+function loadAliases(): AliasMap {
+  const path = process.env.LABEL_ALIASES_PATH;
+  if (!path) return {};
+  try {
+    return JSON.parse(readFileSync(path, 'utf8')) as AliasMap;
+  } catch {
+    return {};
+  }
+}
+
+const ALIASES = loadAliases();
+
+/** Lower-case a label and fold known aliases ("bugfix" → "bug") into one spelling. */
+export function canonicalLabel(label: string): string {
+  const key = label.toLowerCase();
+  return ALIASES[key] ?? key;
+}
