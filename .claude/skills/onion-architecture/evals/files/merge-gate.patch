+export const DEFAULT_MAX_BLOCKERS = 0;
+
+export function maxBlockers(): number {
+  const raw = process.env.DEVDIGEST_MAX_BLOCKERS;
+  if (raw === undefined || raw.trim() === '') return DEFAULT_MAX_BLOCKERS;
+  const parsed = Number.parseInt(raw, 10);
+  return Number.isInteger(parsed) && parsed >= 0 ? parsed : DEFAULT_MAX_BLOCKERS;
+}
