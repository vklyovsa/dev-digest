@@ -0,0 +1,38 @@
+import { Octokit } from 'octokit';
+import type { CommitStatusPublisher, MergeGateReport, RepoRef } from '@devdigest/shared';
+import { withRetry, withTimeout } from '../../platform/resilience.js';
+import { rollupSeverities } from '../../modules/pulls/status.js';
+
+const TIMEOUT = 15_000;
+const STATUS_CONTEXT = 'devdigest/merge-gate';
+const DESCRIPTION_MAX = 140;
+
+export class OctokitCommitStatusPublisher implements CommitStatusPublisher {
+  private octokit: Octokit;
+
+  constructor(token: string) {
+    this.octokit = new Octokit({ auth: token });
+  }
+
+  async publish(repo: RepoRef, sha: string, report: MergeGateReport): Promise<void> {
+    const counts = rollupSeverities(report.findings);
+    const description =
+      `${report.reason} (${counts.critical} critical, ${counts.warning} warning, ${counts.suggestion} suggestion)`.slice(
+        0,
+        DESCRIPTION_MAX,
+      );
+    await withRetry(() =>
+      withTimeout(
+        this.octokit.rest.repos.createCommitStatus({
+          owner: repo.owner,
+          repo: repo.name,
+          sha,
+          state: report.blocked ? 'failure' : 'success',
+          context: STATUS_CONTEXT,
+          description,
+        }),
+        TIMEOUT,
+      ),
+    );
+  }
+}
