@@ -0,0 +1,24 @@
+import type { FindingRow } from '../../db/rows.js';
+
+export interface MergeGateDecision {
+  blocked: boolean;
+  blockers: number;
+  reason: string;
+}
+
+export function decideMergeGate(
+  findings: readonly FindingRow[],
+  maxBlockers: number,
+): MergeGateDecision {
+  const blockers = findings.filter(
+    (f) => f.dismissedAt === null && f.severity === 'CRITICAL',
+  ).length;
+  const blocked = blockers > maxBlockers;
+  return {
+    blocked,
+    blockers,
+    reason: blocked
+      ? `${blockers} critical finding(s), at most ${maxBlockers} allowed`
+      : 'within the allowed number of critical findings',
+  };
+}
