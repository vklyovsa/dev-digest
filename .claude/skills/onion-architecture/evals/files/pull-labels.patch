+  async setLabels(workspaceId: string, prId: string, labels: string[]): Promise<PrLabels> {
+    const pr = await this.pulls.getById(workspaceId, prId);
+    if (!pr) throw new NotFoundError('Pull request not found');
+    if (pr.status !== 'open') {
+      throw new AppError('pull_not_open', 'Labels can only be changed on an open pull request.', 409);
+    }
+
+    const unique = [...new Set(labels.map((l) => l.toLowerCase()))];
+    if (unique.length > MAX_PR_LABELS) {
+      throw new Error(`A pull request can carry at most ${MAX_PR_LABELS} labels`);
+    }
+
+    await this.pulls.updateLabels(pr.id, unique);
+    return { id: pr.id, labels: unique };
+  }
