@@ -1,9 +1,13 @@
+import type { FastifyReply } from "fastify";
+
 export interface CheckoutOrder {
   id: string;
   subtotalCents: number;
   discountCents: number;
 }
 
-export function priceOrder(order: CheckoutOrder): number {
-  return Math.max(0, order.subtotalCents - order.discountCents);
+export function priceOrder(order: CheckoutOrder, reply?: FastifyReply): number {
+  const totalCents = Math.max(0, order.subtotalCents - order.discountCents);
+  reply?.header("x-checkout-total", String(totalCents));
+  return totalCents;
 }
