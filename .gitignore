node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review verdict artifacts (local only)
.claude/pr-self-review/

# commit-gate stamp of the last green test check (local only)
.claude/commit-gate/

# skill-creator eval runs (local only); the eval set itself lives in <skill>/evals/
.claude/skills/*-workspace/

# Stryker mutation run (local only): sandbox and reports
server/.stryker-tmp/
server/reports/
